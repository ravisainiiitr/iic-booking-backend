#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# Named volume production_media is often root-owned; ensure the django user can
# write sync_uploads (and other media) used by DSA resumable uploads.
MEDIA_DIR="${APP_HOME:-/app}/iic_booking/media"
if [ "$(id -u)" = "0" ]; then
  mkdir -p "${MEDIA_DIR}/sync_uploads"
  chown -R django:django "${MEDIA_DIR}" || true
fi

exec "$@"
