# =============================================================================
# IIC Booking — STAGING environment template
# Copy to: .envs/.staging/.django
# NEVER commit real secrets. NEVER point DATABASE_URL at production RDS.
# =============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_STAGING_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,staging.equip.iitr.ac.in
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100,https://staging.equip.iitr.ac.in
# Required so browser on :8100 can call API on :8180 after Omniport redirect (else "Failed to fetch").
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100,http://localhost:8080,http://127.0.0.1:8080
DJANGO_SECURE_SSL_REDIRECT=False
FRONTEND_URL=http://127.0.0.1:8100
STAGING_EXPECTED_DB_NAME=iic_booking_staging

# --- Isolated Postgres (compose service "postgres") ---
POSTGRES_DB=iic_booking_staging
POSTGRES_USER=iic_booking_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
DATABASE_URL=postgres://iic_booking_staging:CHANGE_ME_STAGING_DB_PASSWORD@postgres:5432/iic_booking_staging

# --- Isolated Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- Email sink (Mailpit) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DJANGO_DEFAULT_FROM_EMAIL=IIC Booking STAGING <noreply-staging@localhost>
DJANGO_EMAIL_SUBJECT_PREFIX=[STAGING]

# =============================================================================
# REAL vs FIXTURE mode (mutually exclusive intents)
# =============================================================================
# Operator commands (never auto-edit this file):
#   python manage.py real_integration_status
#   python manage.py real_integration_preflight
#   python manage.py real_integration_activate_staging --write-docs
#
# REAL_INTEGRATION_ENABLED=true  → live Omniport + live OLD_MYSQL_* required;
#                                  fixture flags MUST be false; missing secrets BLOCK.
# REAL_INTEGRATION_ENABLED=false → may enable fixture modes for automated tests only.
# Commands will NOT set this flag automatically.
REAL_INTEGRATION_ENABLED=false

# --- Channel-I / Omniport (staging OAuth app — do not reuse production secrets) ---
# Required for REAL: OMNIPORT_CLIENT_ID, OMNIPORT_CLIENT_SECRET
# Callback for LOCAL Docker staging qualification (this machine):
#   http://127.0.0.1:8180/api/auth/omniport/callback/
# Register that URI with Omniport IN ADDITION TO production — do not remove production URI.
# Production portal callback (equip.iitr.ac.in) terminates on PRODUCTION EC2 — not local staging.
# Future public staging (when DNS/proxy exists):
#   https://staging.equip.iitr.ac.in/api/auth/omniport/callback/
OMNIPORT_CLIENT_ID=
OMNIPORT_CLIENT_SECRET=
OMNIPORT_REDIRECT_URI=http://127.0.0.1:8180/api/auth/omniport/callback/
OMNIPORT_AUTH_URL=https://channeli.in/oauth/authorise/
OMNIPORT_TOKEN_URL=https://channeli.in/oauth/token/
OMNIPORT_USERINFO_URL=https://channeli.in/oauth/userinfo/
# Fixture-only qualification (STAGING only; forbidden when REAL_INTEGRATION_ENABLED=true):
CHANNEL_I_STAGING_FIXTURE_MODE=true
# Authoritative Employee ID claim — set only after live Omniport userinfo proof.
# Live staging proof (staff, empty student/facultyMember payloads): claim NAME = username
# matched admin.users.emp_id (exact match). Students use student.enrolmentNumber.
# Preferred dual rule after review: operator_confirmed_map
# Supported: operator_confirmed_map | username | student.enrolmentNumber | facultyMember.employeeId
CHANNEL_I_AUTHORITATIVE_EMPLOYEE_ID_CLAIM=username

# --- Legacy MySQL READ-ONLY (required for REAL wallet/booking/ledger) ---
# Prefer dedicated READ-ONLY account (e.g. iic_booking_ro). Never use broad admin accounts.
# LOCAL Docker staging qualification via Windows SSH tunnel:
#   OLD_MYSQL_HOST=host.docker.internal
#   OLD_MYSQL_PORT=13306
#   OLD_MYSQL_DATABASE=admin
# Operator must keep tunnel alive: Windows 127.0.0.1:13306 -> jump -> MySQL 127.0.0.1:3306
# After editing this file, recreate containers (restart does NOT reload env_file):
#   docker compose -f docker-compose.staging.yml --env-file .envs/.staging/.django \
#     up -d --force-recreate --no-deps django celeryworker celerybeat
OLD_MYSQL_HOST=host.docker.internal
OLD_MYSQL_PORT=13306
OLD_MYSQL_DATABASE=admin
OLD_MYSQL_USER=iic_booking_ro
OLD_MYSQL_PASSWORD=
# Fixture snapshot (STAGING only; forbidden when REAL MySQL host set / REAL_INTEGRATION_ENABLED):
LEGACY_MYSQL_STAGING_FIXTURE_MODE=true
# LEGACY_MYSQL_STAGING_FIXTURE_PATH=.../staging_legacy_snapshot.json

# --- Storage ---
# LOCAL_STAGING is NOT evidence of real S3. For REAL S3 set:
#   STAGING_STORAGE_BACKEND=S3
#   USE_S3_MEDIA=True
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_STORAGE_BUCKET_NAME=iic-booking-s3-staging (or isolated prefix policy)
# Or formally accept the limitation (still NOT a PASS):
#   LOCAL_STAGING_ACCEPTED=true
STAGING_STORAGE_BACKEND=LOCAL_STAGING
USE_S3_MEDIA=False
# Formal acceptance that LOCAL_STAGING is an intentional staging limitation (NOT an S3 PASS).
# Required for REAL activation GO when S3 is not configured. Leave false to keep S3 as a blocker.
LOCAL_STAGING_ACCEPTED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# --- Feature flags (migration-sensitive OFF initially) ---
STUDENT_LIFECYCLE_ENABLED=False
DEPARTMENT_MAPPING_ENABLED=False

# --- Copilot safe envelope ---
RESEARCH_COPILOT_ENABLED=True
RESEARCH_COPILOT_PILOT_EMAILS=
RESEARCH_COPILOT_MAX_CONCURRENT=1
RESEARCH_COPILOT_MAX_TOKENS=160
COPILOT_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- RAA/DSA: do not point at production agents ---
RA_APPLY_ENV_SETTINGS=False
RA_MOCK_GUACAMOLE=True

# --- Host ports (compose) ---
STAGING_API_HOST_PORT=8180
STAGING_FLOWER_HOST_PORT=5556
STAGING_MAILPIT_UI_PORT=8025
